APP_ENV=development
LOG_LEVEL=INFO

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_EMBEDDING_MODEL=
# 選填：OpenAI 逾時秒數
OPENAI_TIMEOUT_SECONDS=
OPENAI_WEB_SEARCH_TIMEOUT_SECONDS=
OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=

# 必須是 nutri_safe_ai 專用的 Supabase project（已執行 migrations/0001_initial_schema.sql）
# SUPABASE_URL 只能是 https://<project-ref>.supabase.co（不可加 /rest/v1）
SUPABASE_URL=
# 後端專用 secret key（sb_secret_ 開頭，Dashboard → Project Settings → API Keys）
# 不再使用 legacy SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=

# 必須是「呷安心專用」的新 Neo4j instance（已執行 python -m scripts.setup_neo4j）
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# 選填：預設資料庫留空
NEO4J_DATABASE=

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 選填：LINE 一題的處理時限（秒），超過回 ERROR card
RESPONSE_TIMEOUT_SECONDS=
AUTO_IMAGE_BURST_WINDOW_MS=
